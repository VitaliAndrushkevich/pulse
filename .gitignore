# OS files
.DS_Store

# Editor
.vscode/

# Backend artifacts
backend/pulse
backend/*.test

# MCP artifacts
mcp/*.test

# Node / pnpm artifacts (any level — the only real JS project is frontend/)
node_modules/
.pnpm-store/
*.tsbuildinfo

# Stray pnpm/corepack artifacts at the repo root. The frontend owns the only
# package.json + lockfile; running pnpm from the repo root instead of frontend/
# regenerates these at the root — ignore them so they never get committed.
/package.json
/pnpm-lock.yaml
/pnpm-workspace.yaml

# Frontend artifacts
frontend/build/
frontend/.svelte-kit/

# Embedded frontend build output (populated at build time)
backend/internal/frontend/dist/*
!backend/internal/frontend/dist/.gitkeep

# Logs
*.log

# Environment files
.env
.env.*
!.env.example

# Coverage
coverage.out

# Skill files
.agents/skills
.kiro/skills

mcp/bin/
pulse-mcp

docs/audit-working
.worktrees
