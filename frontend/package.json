{
  "name": "pulse-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "svelte-kit sync && vite dev",
    "build": "svelte-kit sync && pnpm validate-locales && vite build",
    "validate-locales": "tsx scripts/validate-locales.ts",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest --run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.10.6",
    "@codemirror/lang-json": "^6.1.2",
    "@codemirror/language": "^6.12.5",
    "@codemirror/lint": "^6.9.9",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.7",
    "codemirror": "^6.0.2",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.72.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.3",
    "@testing-library/svelte": "^5.4.4",
    "@types/node": "^26.4.2",
    "autoprefixer": "^10.5.4",
    "fast-check": "^4.10.0",
    "jsdom": "^29.1.4",
    "postcss": "^8.5.20",
    "sharp": "^0.35.4",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.24.0",
    "typescript": "^5.9.3",
    "vite": "^6.5.0",
    "vitest": "^3.3.0"
  }
}
